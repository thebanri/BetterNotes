        <file alias="icons/app-128.png">../assets/icons/hicolor/org.betternotes.BetterNotes-128.png</file>
        <file alias="icons/app-256.png">../assets/icons/hicolor/org.betternotes.BetterNotes-256.png</file>
    </qresource>
</RCC>
