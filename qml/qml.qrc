        <file>windows/StickyNoteSettingsModal.qml</file>
        <file>windows/WindowPlacement.js</file>
        <file>themes/Theme.qml</file>
        <file>components/StyledButton.qml</file>
        <file>components/StyledTextField.qml</file>
        <file>components/StatusBadge.qml</file>
        <file>components/NoteCard.qml</file>
        <file>components/Tag.qml</file>
        <file>components/AppIcon.qml</file>
        <file>windows/QuickCapture.qml</file>
        <file>components/CommandPalette.qml</file>
        <file alias="icons/app-16.png">../assets/icons/hicolor/org.betternotes.BetterNotes-16.png</file>
        <file alias="icons/app-22.png">../assets/icons/hicolor/org.betternotes.BetterNotes-22.png</file>
        <file alias="icons/app-24.png">../assets/icons/hicolor/org.betternotes.BetterNotes-24.png</file>
        <file alias="icons/app-32.png">../assets/icons/hicolor/org.betternotes.BetterNotes-32.png</file>
        <file alias="icons/app-48.png">../assets/icons/hicolor/org.betternotes.BetterNotes-48.png</file>
