# Maintainer: BetterNotes Contributors
pkgname=betternotes
pkgver=1.0.0
pkgrel=1
pkgdesc="Native, lightweight, Linux-first sticky notes and desktop workspace application"
arch=('x86_64' 'aarch64')
url="https://github.com/thebanri/BetterNotes"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'sqlite')
makedepends=('cargo' 'pkgconf' 'git')
optdepends=(
  'qt6-wayland: Wayland compositor support'
  'libnotify: Desktop notifications'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-targets
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/betternotes" "$pkgdir/usr/bin/betternotes"
  install -Dm644 "packaging/linux/org.betternotes.BetterNotes.desktop" "$pkgdir/usr/share/applications/org.betternotes.BetterNotes.desktop"
  install -Dm644 "packaging/linux/org.betternotes.BetterNotes.metainfo.xml" "$pkgdir/usr/share/metainfo/org.betternotes.BetterNotes.metainfo.xml"
  install -Dm644 "assets/icons/org.betternotes.BetterNotes.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.betternotes.BetterNotes.svg"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
