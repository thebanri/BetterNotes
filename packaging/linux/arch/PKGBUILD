# Maintainer: BetterNotes Contributors
pkgname=betternotes
pkgver=0.1.8
pkgrel=1
pkgdesc="Sticky notes for the Linux desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/thebanri/BetterNotes"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'sqlite' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo')
# The Qt glue is C++ built by cxx-qt into static archives. With makepkg's LTO
# those hold GCC bitcode, which a Rust link through lld cannot resolve.
options=('!lto')
# Releases build the tagged source from GitHub. build-arch.sh points
# BETTERNOTES_SOURCE at a tarball of a working tree instead.
source=("${BETTERNOTES_SOURCE:-$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz}")
sha256sums=('SKIP')

prepare() {
  cd "BetterNotes-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "BetterNotes-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p betternotes
}

check() {
  cd "BetterNotes-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "BetterNotes-$pkgver"
  packaging/linux/stage.sh "$pkgdir" target/release/betternotes
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
