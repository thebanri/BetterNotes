[Desktop Entry]
Name=BetterNotes
GenericName=Sticky Notes & Desktop Workspace
Comment=Native, lightweight, Linux-first sticky notes and desktop workspace
Exec=betternotes %U
Icon=org.betternotes.BetterNotes
Terminal=false
Type=Application
Categories=Utility;Office;TextEditor;
StartupNotify=true
StartupWMClass=betternotes
MimeType=text/plain;text/markdown;application/json;
Keywords=notes;sticky;workspace;markdown;reminders;todo;scratchpad;

Actions=NewNote;QuickCapture;Diagnostics;

[Desktop Action NewNote]
Name=New Note
Exec=betternotes new ""

[Desktop Action QuickCapture]
Name=Quick Capture
Exec=betternotes --quick-capture

[Desktop Action Diagnostics]
Name=Desktop Diagnostics
Exec=betternotes --diagnostics
